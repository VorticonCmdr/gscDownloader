{
  "name": "gsc-crawl-stats-downloader",
  "version": "2.2.1",
  "type": "module",
  "scripts": {
    "prebuild": "node scripts/sync-version.js",
    "dev": "vite build --watch",
    "build": "vite build",
    "lint": "eslint src/",
    "package": "npm run build && cd dist && zip -r ../extension.zip . -x '*.map'",
    "version": "node scripts/sync-version.js && git add src/manifest.json",
    "icons": "node scripts/gen-icons.js"
  },
  "dependencies": {
    "@popperjs/core": "^2.11.8",
    "billboard.js": "^4.1.3",
    "bootstrap": "^5.3.0",
    "jszip": "^3.10.1",
    "papaparse": "^5.4.1",
    "tabulator-tables": "^6.3.0"
  },
  "devDependencies": {
    "bootstrap-icons": "^1.13.2",
    "eslint": "^9.0.0",
    "vite": "^8.3.6",
    "vite-plugin-web-extension": "^4.0.0"
  },
  "engines": {
    "node": ">=20.19"
  }
}
