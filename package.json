{
  "name": "gsc-crawl-stats-downloader",
  "version": "1.5.0",
  "type": "module",
  "scripts": {
    "prebuild": "node scripts/sync-version.js",
    "dev": "vite build --watch",
    "build": "vite build",
    "package": "npm run build && cd dist && zip -r ../extension.zip . -x '*.map'",
    "version": "node scripts/sync-version.js && git add src/manifest.json"
  },
  "dependencies": {
    "@popperjs/core": "^2.11.8",
    "billboard.js": "^3.14.0",
    "bootstrap": "^5.3.0",
    "bootstrap-icons": "^1.11.0",
    "jszip": "^3.10.1",
    "papaparse": "^5.4.1",
    "tabulator-tables": "^6.3.0"
  },
  "devDependencies": {
    "eslint": "^10.5.0",
    "vite": "^5.0.0",
    "vite-plugin-web-extension": "^4.0.0"
  }
}
